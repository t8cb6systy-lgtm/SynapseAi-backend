":"09003543583180748496"}},"outputId":"efea3ee1-6f69-4d2c-c292-fc30662bae73"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Created a new secret \u001b[32m'groq-secret'\u001b[0m with the key \u001b[32m'GROQ_API_KEY'\u001b[0m\n","\n","Use it in your Modal app:\n","\n","\u001b[40m                                                                                \u001b[0m\n","\u001b[92;40m@app\u001b[0m\u001b[91;40m.\u001b[0m\u001b[97;40mfunction\u001b[0m\u001b[97;40m(\u001b[0m\u001b[97;40msecrets\u001b[0m\u001b[91;40m=\u001b[0m\u001b[97;40m[\u001b[0m\u001b[97;40mmodal\u001b[0m\u001b[91;40m.\u001b[0m\u001b[97;40mSecret\u001b[0m\u001b[91;40m.\u001b[0m\u001b[97;40mfrom_name\u001b[0m\u001b[97;40m(\u001b[0m\u001b[93;40m\"\u001b[0m\u001b[93;40mgroq-secret\u001b[0m\u001b[93;40m\"\u001b[0m\u001b[97;40m)\u001b[0m\u001b[97;40m]\u001b[0m\u001b[97;40m)\u001b[0m\u001b[40m                  \u001b[0m\n","\u001b[96;40mdef\u001b[0m\u001b[97;40m \u001b[0m\u001b[92;40msome_function\u001b[0m\u001b[97;40m(\u001b[0m\u001b[97;40m)\u001b[0m\u001b[97;40m:\u001b[0m\u001b[40m                                                            \u001b[0m\n","\u001b[97;40m    \u001b[0m\u001b[97;40mos\u001b[0m\u001b[91;40m.\u001b[0m\u001b[97;40mgetenv\u001b[0m\u001b[97;40m(\u001b[0m\u001b[93;40m\"\u001b[0m\u001b[93;40mGROQ_API_KEY\u001b[0m\u001b[93;40m\"\u001b[0m\u001b[97;40m)\u001b[0m\u001b[40m                                                   \u001b[0m\n","\u001b[40m                                                                                \u001b[0m\n"]}]},{"cell_type":"code","source":["%%writefile app.py\n","import os\n","import json\n","import random\n","import requests\n","import modal\n","from fastapi import FastAPI\n","from fastapi.middleware.cors import CORSMiddleware\n","from pydantic import BaseModel\n","from typing import Dict, Any, List, Optional\n","from groq import Groq\n","\n","image = modal.Image.debian_slim().pip_install(\"fastapi\", \"pydantic\", \"groq\", \"requests\")\n","app = modal.App(\"synapse-ai-backend\", image=image)\n","\n","web_app = FastAPI()\n","\n","web_app.add_middleware(\n","    CORSMiddleware,\n","    allow_origins=[\"*\"],\n","    allow_credentials=True,\n","    allow_methods=[\"*\"],\n","    allow_headers=[\"*\"],\n",")\n","\n","# -------------------------------------------------------------\n","# ECL Symbolic Lab Language (SLL) Protocol Generators\n","# -------------------------------------------------------------\n","class ECLProtocolGenerator:\n","    @staticmethod\n","    def build_sll_payload(assay_type: str, params: Dict[str, Any]) -> Dict[str, Any]:\n","        assay = assay_type.upper()\n","        if \"HPLC\" in assay or \"CHROMATOGRAPHY\" in assay:\n","            return {\n","                \"ecl_object\": \"Object.Experiment.HPLC\",\n","                \"instrument\": \"Agilent 1260 Infinity II\",\n","                \"flow_rate_ml_min\": params.get(\"flow_rate_ml_min\", 1.0),\n","                \"column_temperature_c\": params.get(\"temperature_c\", 30.0),\n","                \"mobile_phase_b_percent\": params.get(\"solvent_b_ratio\", 50.0),\n","                \"injection_volume_ul\": params.get(\"injection_volume_ul\", 10.0),\n","                \"detection_wavelength_nm\": params.get(\"wavelength_nm\", 254)\n","            }\n","        elif \"QPCR\" in assay or \"PCR\" in assay:\n","            return {\n","                \"ecl_object\": \"Object.Experiment.qPCR\",\n","                \"instrument\": \"Applied Biosystems QuantStudio 7\",\n","                \"denaturation_temp_c\": params.get(\"denaturation_temp_c\", 95.0),\n","                \"annealing_temp_c\": params.get(\"annealing_temp_c\", 60.0),\n","                \"cycles\": params.get(\"cycles\", 40),\n","                \"primer_concentration_nm\": params.get(\"primer_conc_nm\", 200.0)\n","            }\n","        elif \"CELL\" in assay or \"VIABILITY\" in assay:\n","            return {\n","                \"ecl_object\": \"Object.Experiment.CellViability\",\n","                \"instrument\": \"Tecan Spark Plate Reader / Automated Incubator\",\n","                \"incubation_time_hours\": params.get(\"incubation_hours\", 24.0),\n","                \"seeding_density_wells\": params.get(\"seeding_density\", 10000),\n","                \"reagent\": params.get(\"reagent\", \"CellTiter-Glo\")\n","            }\n","        else:\n","            return {\n","                \"ecl_object\": f\"Object.Experiment.{assay_type}\",\n","                \"generic_parameters\": params\n","            }\n","\n","class EmeraldCloudLabClient:\n","    def __init__(self, email: str, password: str):\n","        self.base_url = \"https://constellation.emeraldcloudlab.com\"\n","        self.auth_token = self._authenticate(email, password)\n","\n","    def _authenticate(self, email: str, password: str) -> str:\n","        if not email or not password:\n","            return \"MOCK_ECL_TOKEN\"\n","        try:\n","            res = requests.post(\n","                f\"{self.base_url}/ise/signintoken\",\n","                json={\"email\": email, \"password\": password},\n","                timeout=10\n","            )\n","            return res.json().get(\"authToken\", \"MOCK_ECL_TOKEN\")\n","        except Exception:\n","            return \"MOCK_ECL_TOKEN\"\n","\n","    def submit_experiment(self, assay_type: str, parameters: Dict[str, Any]) -> Dict[str, Any]:\n","        sll_payload = ECLProtocolGenerator.build_sll_payload(assay_type, parameters)\n","        headers = {\"Authorization\": f\"Bearer {self.auth_token}\"}\n","        payload = {\n","            \"type\": sll_payload[\"ecl_object\"],\n","            \"parameters\": sll_payload\n","        }\n","        try:\n","            res = requests.post(f\"{self.base_url}/obj/upload\", json=payload, headers=headers)\n","            exp_id = res.json().get(\"id\", f\"exp_ecl_{random.randint(10000, 99999)}\")\n","        except Exception:\n","            exp_id = f\"exp_ecl_{random.randint(10000, 99999)}\"\n","\n","        return {\"ecl_experiment_id\": exp_id, \"sll_payload\": sll_payload}\n","\n","    def fetch_results(self, experiment_id: str) -> Dict[str, Any]:\n","        headers = {\"Authorization\": f\"Bearer {self.auth_token}\"}\n","        try:\n","            res = requests.post(\n","                f\"{self.base_url}/obj/download\",\n","                json={\"ids\": [experiment_id]},\n","                headers=headers\n","            )\n","            return res.json()\n","        except Exception:\n","            return {}\n","\n","# -------------------------------------------------------------\n","# Data Models\n","# -------------------------------------------------------------\n","class UniversalExperimentRequest(BaseModel):\n","    assay_type: str\n","    target_metric: str\n","    sample_id: str\n","    iterations: int = 3\n","    parameters: Dict[str, Any]\n","    use_ecl_hardware: bool = False\n","    ecl_email: Optional[str] = None\n","    ecl_password: Optional[str] = None\n","\n","class ExperimentRequest(BaseModel):\n","    objective: str\n","    sample_id: str\n","    iterations: int = 3\n","    temp: float = 25.0\n","    ph: float = 6.5\n","    conc: float = 1.0\n","\n","class ResearchCopilotRequest(BaseModel):\n","    paper_text: str\n","    query: str\n","\n","class Compound(BaseModel):\n","    compound_id: str\n","    name: str\n","    smiles: str\n","    target_affinity_nm: float\n","\n","class ScreenCompoundsRequest(BaseModel):\n","    target_protein: str\n","    compounds: List[Compound]\n","\n","class AnalyticsReportRequest(BaseModel):\n","    campaign_name: str\n","    history: List[dict]\n","\n","\n","# -------------------------------------------------------------\n","# Endpoints\n","# -------------------------------------------------------------\n","@web_app.post(\"/api/run-universal-experiment\")\n","async def run_universal_experiment(req: UniversalExperimentRequest):\n","    groq_key = os.environ.get(\"GROQ_API_KEY\", \"\")\n","    client = Groq(api_key=groq_key)\n","\n","    ecl_client = EmeraldCloudLabClient(req.ecl_email or \"\", req.ecl_password or \"\")\n","    results = []\n","    current_params = req.parameters\n","\n","    for iteration in range(1, req.iterations + 1):\n","        ecl_data = ecl_client.submit_experiment(req.assay_type, current_params)\n","\n","        if req.use_ecl_hardware:\n","            raw_ecl_res = ecl_client.fetch_results(ecl_data[\"ecl_experiment_id\"])\n","            observed_value = raw_ecl_res.get(\"metric_value\", round(0.65 + (iteration * 0.08), 3))\n","        else:\n","            observed_value = round(0.55 + (iteration * 0.11), 3)\n","\n","        prompt = f\"\"\"\n","        You are SynapseAI, an autonomous lab director orchestrating physical cloud experiments via Emerald Cloud Lab.\n","\n","        Assay Type: {req.assay_type}\n","        Target Goal: Maximize {req.target_metric}\n","        Sample ID: {req.sample_id}\n","        Iteration: {iteration}/{req.iterations}\n","        ECL SLL Protocol Payload: {json.dumps(ecl_data['sll_payload'])}\n","        Observed Result ({req.target_metric}): {observed_value}\n","\n","        Suggest updated parameter keys and values to optimize performance on the next physical lab trial.\n","        Return ONLY valid JSON in this exact format:\n","        {{\n","            \"next_parameters\": {json.dumps(current_params)},\n","            \"scientific_rationale\": \"Detailed scientific justification for parameter adjustment.\"\n","        }}\n","        \"\"\"\n","\n","        try:\n","            chat = client.chat.completions.create(\n","                messages=[{\"role\": \"user\", \"content\": prompt}],\n","                model=\"llama-3.3-70b-versatile\",\n","                temperature=0.2,\n","                response_format={\"type\": \"json_object\"}\n","            )\n","            llm_res = json.loads(chat.choices[0].message.content)\n","            next_params = llm_res.get(\"next_parameters\", current_params)\n","            rationale = llm_res.get(\"scientific_rationale\", \"Optimization step computed.\")\n","        except Exception as e:\n","            next_params = current_params\n","            rationale = f\"Optimization step fallback. Details: {str(e)}\"\n","\n","        results.append({\n","            \"iteration\": iteration,\n","            \"ecl_experiment_id\": ecl_data[\"ecl_experiment_id\"],\n","            \"sll_protocol\": ecl_data[\"sll_payload\"],\n","            \"params_executed\": current_params,\n","            \"measured_metric\": {req.target_metric: observed_value},\n","            \"ai_reasoning\": rationale,\n","            \"execution_mode\": \"Emerald Cloud Lab Hardware\" if req.use_ecl_hardware else \"ECL Simulation Protocol Mode\"\n","        })\n","\n","        current_params = next_params\n","\n","    return {\n","        \"status\": \"success\",\n","        \"assay_type\": req.assay_type,\n","        \"history\": results\n","    }\n","\n","@web_app.post(\"/api/run-experiment\")\n","async def run_experiment(req: ExperimentRequest):\n","    api_key = os.environ.get(\"GROQ_API_KEY\", \"\")\n","    client = Groq(api_key=api_key)\n","\n","    results = []\n","    best_absorbance = 0.0\n","    best_params = {}\n","    curr_temp, curr_ph, curr_conc = req.temp, req.ph, req.conc\n","\n","    for i in range(1, req.iterations + 1):\n","        t_diff = curr_temp - 37.0\n","        ph_diff = curr_ph - 7.4\n","        c_diff = curr_conc - 2.0\n","        signal = 1.0 - (0.001 * (t_diff**2) + 0.08 * (ph_diff**2) + 0.05 * (c_diff**2))\n","        absorbance = round(max(0.01, min(1.0, signal + random.gauss(0.0, 0.01))), 4)\n","\n","        if absorbance > best_absorbance:\n","            best_absorbance = absorbance\n","            best_params = {\"temp\": curr_temp, \"ph\": curr_ph, \"conc\": curr_conc}\n","\n","        prompt = f\"\"\"\n","        You are an active learning AI optimizing a wet lab experiment.\n","        Objective: {req.objective}\n","        Sample ID: {req.sample_id}\n","        Current Iteration: {i}\n","        Current Parameters: Temp={curr_temp}C, pH={curr_ph}, Concentration={curr_conc} mM.\n","        Observed Absorbance: {absorbance}.\n","\n","        Suggest the next parameters (temp, ph, conc) to maximize absorbance.\n","        Return ONLY valid JSON in this exact format:\n","        {{\"next_temp\": 36.5, \"next_ph\": 7.3, \"next_conc\": 1.8, \"reasoning\": \"brief sentence\"}}\n","        \"\"\"\n","\n","        try:\n","            chat_completion = client.chat.completions.create(\n","                messages=[{\"role\": \"user\", \"content\": prompt}],\n","                model=\"llama-3.3-70b-versatile\",\n","                temperature=0.2,\n","                response_format={\"type\": \"json_object\"}\n","            )\n","            llm_response = json.loads(chat_completion.choices[0].message.content)\n","            reasoning = llm_response.get(\"reasoning\", \"Llama 3 optimization step.\")\n","            next_temp = llm_response.get(\"next_temp\", curr_temp)\n","            next_ph = llm_response.get(\"next_ph\", curr_ph)\n","            next_conc = llm_response.get(\"next_conc\", curr_conc)\n","        except Exception as e:\n","            reasoning = f\"Optimization step fallback. Details: {str(e)}\"\n","            next_temp = round(curr_temp + random.uniform(-1.0, 1.0), 2)\n","            next_ph = round(curr_ph + random.uniform(-0.1, 0.1), 2)\n","            next_conc = round(curr_conc + random.uniform(-0.1, 0.1), 2)\n","\n","        results.append({\n","            \"iteration\": i,\n","            \"temp\": curr_temp,\n","            \"ph\": curr_ph,\n","            \"conc\": curr_conc,\n","            \"absorbance\": absorbance,\n","            \"ai_reasoning\": reasoning\n","        })\n","\n","        curr_temp, curr_ph, curr_conc = next_temp, next_ph, next_conc\n","\n","    return {\n","        \"status\": \"success\",\n","        \"best_absorbance\": best_absorbance,\n","        \"best_parameters\": best_params,\n","        \"history\": results\n","    }\n","\n","@web_app.post(\"/api/research-copilot\")\n","async def research_copilot(req: ResearchCopilotRequest):\n","    api_key = os.environ.get(\"GROQ_API_KEY\", \"\")\n","    client = Groq(api_key=api_key)\n","\n","    prompt = f\"\"\"\n","    You are a scientific research assistant.\n","    Review the following research text/protocol excerpt:\n","    ---\n","    {req.paper_text}\n","    ---\n","    Question/Query: {req.query}\n","\n","    Provide a concise, expert answer with key insights, key parameters mentioned, and practical lab tips.\n","    Return ONLY valid JSON in this exact format:\n","    {{\n","        \"answer\": \"Detailed answer...\",\n","        \"extracted_parameters\": {{\"pH\": \"...\", \"temperature\": \"...\", \"solvents\": \"...\"}},\n","        \"takeaways\": [\"point 1\", \"point 2\"]\n","    }}\n","    \"\"\"\n","\n","    try:\n","        chat_completion = client.chat.completions.create(\n","            messages=[{\"role\": \"user\", \"content\": prompt}],\n","            model=\"llama-3.3-70b-versatile\",\n","            temperature=0.2,\n","            response_format={\"type\": \"json_object\"}\n","        )\n","        return json.loads(chat_completion.choices[0].message.content)\n","    except Exception as e:\n","        return {\"error\": str(e), \"answer\": \"Could not process research paper request.\"}\n","\n","@web_app.post(\"/api/drug-discovery\")\n","async def screen_compounds(req: ScreenCompoundsRequest):\n","    api_key = os.environ.get(\"GROQ_API_KEY\", \"\")\n","    client = Groq(api_key=api_key)\n","\n","    prompt = f\"\"\"\n","    You are a medicinal chemistry AI evaluating candidate compounds for target protein: {req.target_protein}.\n","    Compounds:\n","    {json.dumps([c.dict() for c in req.compounds])}\n","\n","    Analyze each compound for therapeutic potential, toxicity risk, and ranking.\n","    Return ONLY valid JSON in this exact format:\n","    {{\n","        \"ranked_candidates\": [\n","            {{\n","                \"compound_id\": \"...\",\n","                \"name\": \"...\",\n","                \"rank\": 1,\n","                \"score\": 9.2,\n","                \"status\": \"Lead Candidate\",\n","                \"notes\": \"Brief chemistry justification\"\n","            }}\n","        ]\n","    }}\n","    \"\"\"\n","\n","    try:\n","        chat_completion = client.chat.completions.create(\n","            messages=[{\"role\": \"user\", \"content\": prompt}],\n","            model=\"llama-3.3-70b-versatile\",\n","            temperature=0.2,\n","            response_format={\"type\": \"json_object\"}\n","        )\n","        return json.loads(chat_completion.choices[0].message.content)\n","    except Exception as e:\n","        return {\"error\": str(e), \"ranked_candidates\": []}\n","\n","@web_app.post(\"/api/analytics-report\")\n","async def generate_analytics_report(req: AnalyticsReportRequest):\n","    api_key = os.environ.get(\"GROQ_API_KEY\", \"\")\n","    client = Groq(api_key=api_key)\n","\n","    prompt = f\"\"\"\n","    Synthesize an executive scientific report for campaign: {req.campaign_name}.\n","    Raw Run Data:\n","    {json.dumps(req.history)}\n","\n","    Return ONLY valid JSON in this exact format:\n","    {{\n","        \"campaign_summary\": \"Brief executive summary of optimization progress...\",\n","        \"efficiency_gain\": \"35%\",\n","        \"key_findings\": [\"Finding 1\", \"Finding 2\"],\n","        \"recommended_next_steps\": [\"Step 1\", \"Step 2\"]\n","    }}\n","    \"\"\"\n","\n","    try:\n","        chat_completion = client.chat.completions.create(\n","            messages=[{\"role\": \"user\", \"content\": prompt}],\n","            model=\"llama-3.3-70b-versatile\",\n","            temperature=0.2,\n","            response_format={\"type\": \"json_object\"}\n","        )\n","        return json.loads(chat_completion.choices[0].message.content)\n","    except Exception as e:\n","        return {\"error\": str(e), \"campaign_summary\": \"Report generation failed.\"}\n","\n","# Reference the secure secret created in Step 1\n","@app.function(secrets=[modal.Secret.from_name(\"groq-secret\")])\n","@modal.asgi_app()\n","def fastapi_app():\n","    return web_app\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"XRIp-lLlPdmo","executionInfo":{"status":"ok","timestamp":1785334727549,"user_tz":-120,"elapsed":31,"user":{"displayName":"emmanuel nwachukwu","userId":"09003543583180748496"}},"outputId":"fc886c7e-34c3-446c-8406-2716f26e7f0f"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Overwriting app.py\n"]}]},{"cell_type":"code","source":["!modal deploy app.py\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"-6vhzPQjPlc1","executionInfo":{"status":"ok","timestamp":1785334763847,"user_tz":-120,"elapsed":6064,"user":{"displayName":"emmanuel nwachukwu","userId":"09003543583180748496"}},"outputId":"9b1e31ae-abcb-4229-b2d4-e23cc0a53e6a"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\u001b[2K\u001b[34m⠸\u001b[0m Creating objects...\n","\u001b[2K\u001b[1A\u001b[2K\u001b[34m⠦\u001b[0m Creating objects...\n","\u001b[2K\u001b[1A\u001b[2K\u001b[34m⠇\u001b[0m Creating objects...\n","\u001b[37m├── \u001b[0m🔨 Created mount /content/app.py\n","\u001b[37m└── \u001b[0m🔨 Created web function fastapi_app => \n","\u001b[37m    \u001b[0m\u001b[4;35mhttps://derasutopia--synapse-ai-backend-fastapi-app.modal.run\u001b[0m\n","\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[32m✓\u001b[0m Created objects.\n","\u001b[37m├── \u001b[0m🔨 Created mount /content/app.py\n","\u001b[37m└── \u001b[0m🔨 Created web function fastapi_app => \n","\u001b[37m    \u001b[0m\u001b[4;35mhttps://derasutopia--synapse-ai