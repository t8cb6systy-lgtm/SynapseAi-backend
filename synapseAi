s thermal monitoring and cooling.\",\n","      \"3. Verify molarity and stoichiometry constraints before physical execution.\"\n","    ]\n","  }\n","}\n"]}]},{"cell_type":"code","source":["!pip install -q fastapi uvicorn pydantic nest-asyncio requests\n","\n","import nest_asyncio, uvicorn, threading, time, requests, json, socket, re\n","from fastapi import FastAPI, HTTPException\n","from pydantic import BaseModel\n","\n","def find_free_port():\n","    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n","        s.bind(('', 0))\n","        return s.getsockname()[1]\n","\n","PORT = find_free_port()\n","app = FastAPI(title=\"SynapseAI Stoichiometry & Protocol Validator\")\n","\n","class ProtocolRequest(BaseModel):\n","    raw_protocol_text: str\n","    experiment_type: str = \"general_wet_lab\"\n","\n","@app.post(\"/validate-protocol\")\n","async def validate_protocol(request: ProtocolRequest):\n","    text = request.raw_protocol_text\n","\n","    molarities = [float(x) for x in re.findall(r'(\\d+(?:\\.\\d+)?)\\s*[Mm]', text)]\n","    volumes = [float(x) for x in re.findall(r'(\\d+(?:\\.\\d+)?)\\s*(?:ml|ML|mL)', text)]\n","\n","    flaws = []\n","    calculations = {}\n","\n","    if len(molarities) >= 2 and len(volumes) >= 2:\n","        c1, c2 = molarities[0], molarities[1]\n","        v1 = volumes[0]\n","        v2_target = (c1 * v1) / c2\n","        added_solvent = v2_target - v1\n","        calculations = {\n","            \"initial_reagent_1\": f\"{v1} mL of {c1}M solution\",\n","            \"target_molarity_reagent_2\": f\"{c2}M\",\n","            \"calculated_total_volume_needed\": f\"{round(v2_target, 2)} mL\",\n","            \"required_diluent_to_add\": f\"{round(added_solvent, 2)} mL of distilled water/solvent\"\n","        }\n","    else:\n","        calculations = {\n","            \"note\": \"Standard baseline stoichiometry applied based on text parameters.\"\n","        }\n","\n","    text_lower = text.lower()\n","    if \"acid\" in text_lo