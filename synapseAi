API()\n","\n","web_app.add_middleware(\n","    CORSMiddleware,\n","    allow_origins=[\"*\"],\n","    allow_credentials=True,\n","    allow_methods=[\"*\"],\n","    allow_headers=[\"*\"],\n",")\n","\n","# -------------------------------------------------------------\n","# ECL Constellation API Helper\n","# -------------------------------------------------------------\n","class EmeraldCloudLabClient:\n","    def __init__(self, email: str, password: str):\n","        self.base_url = \"https://constellation.emeraldcloudlab.com\"\n","        self.auth_token = self._authenticate(email, password)\n","\n","    def _authenticate(self, email: str, password: str) -> str:\n","        \"\"\"Authenticate with ECL to receive a Bearer AuthToken.\"\"\"\n","        if not email or not password:\n","            return \"MOCK_ECL_TOKEN\" # Fallback if credentials aren't provided yet\n","        try:\n","            res = requests.post(\n","                f\"{self.base_url}/ise/signintoken\",\n","                json={\"email\": email, \"password\": password},\n","                timeout=10\n","            )\n","            return res.json().get(\"authToken\", \"MOCK_ECL_TOKEN\")\n","        except Exception:\n","            return \"MOCK_ECL_TOKEN\"\n","\n","    def submit_experiment(self, experiment_type: str, parameters: Dict[str, Any]) -> str:\n","        \"\"\"Submit a multi-method experiment (HPLC, Mass Spec, Cell Viability, qPCR, etc.) to ECL.\"\"\"\n","        headers = {\"Authorization\": f\"Bearer {self.auth_token}\"}\n","        payload = {\n","            \"type\": f\"Object.Experiment.{experiment_type}\",\n","            \"parameters\": parameters\n","        }\n","        try:\n","            res = requests.post(f\"{self.base_url}/obj/upload\", json=payload, headers=headers)\n","            return res.json().get(\"id\", \"exp_ecl_mock_12345\")\n","        except Exception:\n","            return \"exp_ecl_mock_12345\"\n","\n","    def fetch_results(self, experiment_id: str) -> Dict[str, Any]:\n","        \"\"\"Poll ECL for final experimental dataset.\"\"\"\n","        headers = {\"Authorization\": f\"Bearer {self.auth_token}\"}\n","        try:\n","            res = requests.post(\n","                f\"{self.base_url}/obj/download\",\n","                json={\"ids\": [experiment_id]},\n","                headers=headers\n","            )\n","            return res.json()\n","        except Exception:\n","            return {}\n","\n","\n","# -------------------------------------------------------------\n","# Generalized Experiment Data Request\n","# -------------------------------------------------------------\n","class UniversalExperimentRequest(BaseModel):\n","    assay_type: str  # e.g., \"HPLC\", \"FlowCytometry\", \"LC-MS\", \"qPCR\", \"EnzymeKinetics\"\n","    target_metric: str # e.g., \"Peak Resolution\", \"Cell Viability %\", \"Yield %\", \"Binding Affinity\"\n","    sample_id: str\n","    iterations: int = 3\n","    parameters: Dict[str, Any] # e.g., {\"temperature\": 37.0, \"pH\": 7.4, \"flow_rate\": 1.2, \"incubation_time_min\": 45}\n","    use_ecl_hardware: bool = False\n","    ecl_email: Optional[str] = None\n","    ecl_password: Optional[str] = None\n","\n","\n","@web_app.post(\"/api/run-universal-experiment\")\n","async def run_universal_experiment(req: UniversalExperimentRequest):\n","    groq_key = os.environ.get(\"GROQ_API_KEY\", \"\")\n","    client = Groq(api_key=groq_key)\n","\n","    # Initialize ECL connection if requested\n","    ecl_client = None\n","    if req.use_ecl_hardware and req.ecl_email and req.ecl_password:\n","        ecl_client = EmeraldCloudLabClient(req.ecl_email, req.ecl_password)\n","\n","    results = []\n","    current_params = req.parameters\n","\n","    for iteration in range(1, req.iterations + 1):\n","        if ecl_client:\n","            # 1. Trigger live physical hardware execution on Emerald Cloud Lab\n","            ecl_exp_id = ecl_client.submit_experiment(req.assay_type, current_params)\n","\n","            # 2. Fetch physical measurement data from ECL\n","            raw_ecl_data = ecl_client.fetch_results(ecl_exp_id)\n","\n","            # Extract measured metric (or mock fallback if job is still queued)\n","            observed_value = raw_ecl_data.get(\"metric_value\", round(0.5 + (iteration * 0.1), 3))\n","        else:\n","            # Mathematical placeholder when offline\n","            observed_value = round(0.5 + (iteration * 0.12), 3)\n","\n","        # 3. Pass assay context to Llama 3 to reason through ANY scientific methodology\n","        prompt = f\"\"\"\n","        You are SynapseAI, an autonomous lab director orchestrating physical cloud experiments.\n","\n","        Assay Type: {req.assay_type}\n","        Target Goal: Maximize/Optimize {req.target_metric}\n","        Sample ID: {req.sample_id}\n","        Iteration: {iteration}/{req.iterations}\n","        Current Executed Parameters: {json.dumps(current_params)}\n","        Observed Result ({req.target_metric}): {observed_value}\n","\n","        Reason through the underlying chemical/biological mechanisms. Suggest the exact parameters to run on the next physical lab trial.\n","        Return ONLY valid JSON:\n","        {{\n","            \"next_parameters\": {json.dumps(current_params)},\n","            \"scientific_rationale\": \"Detailed chemistry/biology reasoning for this parameter adjustment.\"\n","        }}\n","        \"\"\"\n","\n","        try:\n","            chat = client.chat.completions.create(\n","                messages=[{\"role\": \"user\", \"content\": prompt}],\n","                model=\"llama-3.3-70b-versatile\",\n","                temperature=0.2,\n","                response_format={\"type\": \"json_object\"}\n","            )\n","            llm_res = json.loads(chat.choices[0].message.content)\n","            next_params = llm_res.get(\"next_parameters\", current_params)\n","            rationale = llm_res.get(\"scientific_rationale\", \"Optimization step computed.\")\n","        except Exception:\n","            next_params = current_params\n","            rationale = \"Algorithmic adjustment.\"\n","\n","        results.append({\n","            \"iteration\": iteration,\n","            \"params_executed\": current_params,\n","            \"measured_metric\": {req.target_metric: observed_value},\n","            \"ai_reasoning\": rationale,\n","            \"execution_mode\": \"Emerald Cloud Lab Hardware\" if ecl_client else \"Simulation Mode\"\n","        })\n","\n","        current_params = next_params\n","\n","    return {\n","        \"status\": \"success\",\n","        \"assay_type\": req.assay_type,\n","        \"history\": results\n","    }\n","\n","\n","@app.function(secrets=[modal.Secret.from_dict({\n","    \"GROQ_API_KEY\": \"Gsk_ufzN5PHcgtcL4tfKci9LWGdyb3FYTDxXnoN5zkznRgXHZg7cMrLI\"\n","})])\n","@modal.asgi_app()\n","def fastapi_app():\n","    return web_app\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"RXS3XnG-IyQH","executionInfo":{"status":"ok","timestamp":1785332979520,"user_tz":-120,"elapsed":55,"user":{"displayName":"emmanuel nwachukwu","userId":"09003543583180748496"}},"outputId":"5decadeb-6bcd-4551-df07-330c2b76909d"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Overwriting app.py\n"]}]},{"cell_type":"code","source":["!modal deploy app.py\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"o_4kB2x9I6_F","executionInfo":{"status":"ok","timestamp":1785333022204,"user_tz":-120,"elapsed":13013,"user":{"displayName":"emmanuel nwachukwu","userId":"09003543583180748496"}},"outputId":"a5af8d73-a702-49dd-deef-ffa8686468dd"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\u001b[2K\u001b[34m⠸\u001b[0m Creating objects...\n","\u001b[2K\u001b[1A\u001b[2K\u001b[34m⠦\u001b[0m Creating objects...\n","\u001b[2K\u001b[1A\u001b[2K\u001b[34m⠏\u001b[0m Creating objects...\n","\u001b[2K\u001