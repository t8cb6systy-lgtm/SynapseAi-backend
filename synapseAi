ors import CORSMiddleware\n","from pydantic import BaseModel\n","from typing import Dict, Any, List, Optional\n","from groq import Groq\n","from supabase import create_client, Client\n","\n","# Modal Setup\n","image = modal.Image.debian_slim().pip_install(\"fastapi\", \"pydantic\", \"groq\", \"requests\", \"supabase\")\n","app = modal.App(\"synapse-ai-backend\", image=image)\n","\n","web_app = FastAPI()\n","\n","web_app.add_middleware(\n","    CORSMiddleware,\n","    allow_origins=[\"*\"],\n","    allow_credentials=True,\n","    allow_methods=[\"*\"],\n","    allow_headers=[\"*\"],\n",")\n","\n","# -------------------------------------------------------------\n","# Database & Audit Logging Helpers\n","# -------------------------------------------------------------\n","def get_supabase() -> Optional[Client]:\n","    url = os.environ.get(\"SUPABASE_URL\")\n","    key = os.environ.get(\"SUPABASE_KEY\")\n","    if url and key:\n","        return create_client(url, key)\n","    return None\n","\n","def log_audit_trail(endpoint: str, prompt: str, response: dict, execution_time: float):\n","    try:\n","        db = get_supabase()\n","        if db:\n","            db.table(\"audit_logs\").insert({\n","                \"endpoint\": endpoint,\n","                \"prompt_text\": prompt,\n","                \"raw_llm_response\": response,\n","                \"execution_time_ms\": round(execution_time * 1000, 2)\n","            }).execute()\n","    except Exception as e:\n","        print(f\"Audit log error: {str(e)}\")\n","\n","def save_experiment_history(sample_id: str, assay_type: str, execution_mode: str, history: List[dict]):\n","    try:\n","        db = get_supabase()\n","        if db:\n","            db.table(\"experiment_history\").insert({\n","                \"sample_id\": sample_id,\n","                \"assay_type\": assay_type,\n","                \"execution_mode\": execution_mode,\n","                \"history\": history\n","            }).execute()\n","    except Exception as e:\n","        print(f\"History save error: {str(e)}\")\n","\n","# -------------------------------------------------------------\n","# Request Models\n","# -------------------------------------------------------------\n","class UniversalExperimentRequest(BaseModel):\n","    assay_type: str\n","    target_metric: str\n","    sample_id: str\n","    iterations: int = 3\n","    parameters: Dict[str, Any]\n","    use_ecl_hardware: bool = False\n","\n","class CompoundScreeningRequest(BaseModel):\n","    target_protein: str\n","    smiles_list: List[str]\n","\n","class AnalyticsReportRequest(BaseModel):\n","    campaign_id: str\n","    metrics: Dict[str, Any]\n","\n","# -------------------------------------------------------------\n","# Endpoints (All 5 Preserved)\n","# -------------------------------------------------------------\n","\n","# 1. Universal Experiment Runner\n","@web_app.post(\"/api/run-universal-experiment\")\n","async def run_universal_experiment(req: UniversalExperimentRequest):\n","    start_time = time.time()\n","    groq_key = os.environ.get(\"GROQ_API_KEY\", \"\")\n","    client = Groq(api_key=groq_key)\n","\n","    results = []\n","    current_params = req.parameters\n","\n","    for iteration in range(1, req.iterations + 1):\n","        observed_value = round(0.55 + (iteration * 0.11), 3)\n","\n","        prompt = f\"\"\"\n","        Assay: {req.assay_type}, Target: {req.target_metric}, Iteration: {iteration}/{req.iterations}\n","        Parameters: {json.dumps(current_params)}, Observed: {observed_value}\n","        Return JSON: {{\"next_parameters\": {json.dumps(current_params)}, \"scientific_rationale\": \"...\"}}\n","        \"\"\"\n","\n","        try:\n","            chat = client.chat.completions.create(\n","                messages=[{\"role\": \"user\", \"content\": prompt}],\n","                model=\"llama-3.3-70b-versatile\",\n","                temperature=0.2,\n","                response_format={\"type\": \"json_object\"}\n","            )\n","            llm_res = json.loads(chat.choices[0].message.content)\n","            next_params = llm_res.get(\"next_parameters\", current_params)\n","            rationale = llm_res.get(\"scientific_rationale\", \"Optimization step computed.\")\n","\n","            log_audit_trail(\n","                endpoint=\"/api/run-universal-experiment\",\n","                prompt=prompt,\n","                response=llm_res,\n","                execution_time=time.time() - start_time\n","            )\n","        except Exception as e:\n","            next_params = current_params\n","            rationale = f\"Fallback step: {str(e)}\"\n","\n","        results.append({\n","            \"iteration\": iteration,\n","            \"params_executed\": current_params,\n","            \"measured_metric\": {req.target_metric: observed_value},\n","            \"ai_reasoning\": rationale\n","        })\n","\n","        current_params = next_params\n","\n","    mode = \"ECL Hardware\" if req.use_ecl_hardware else \"Simulation Mode\"\n","    save_experiment_history(req.sample_id, req.assay_type, mode, results)\n","\n","    return {\n","        \"status\": \"success\",\n","        \"sample_id\": req.sample_id,\n","        \"history\": results\n","    }\n","\n","# 2. Research Copilot (Conversational - Text input safe from JSON errors)\n","@web_app.post(\"/api/research-copilot\")\n","async def research_copilot(message: str = Body(..., embed=True)):\n","    start_time = time.time()\n","    groq_key = os.environ.get(\"GROQ_API_KEY\", \"\")\n","    client = Groq(api_key=groq_key)\n","\n","    system_prompt = \"\"\"\n","    You are an expert biotech and laboratory copilot.\n","    Analyze the user's input text (which may be a scientific question, protocol excerpt, or paper text).\n","\n","    Return a structured JSON object with:\n","    1. \"answer\": A direct, comprehensive response or summary addressing the input.\n","    2. \"extracted_parameters\": A dictionary of any specific lab/assay parameters found (e.g. pH, temperature, concentrations, flow rates, durations). Use \"Not specified\" if none exist.\n","    3. \"takeaways\": A list of 2-3 key scientific insights or next step recommendations based on the input.\n","    \"\"\"\n","\n","    try:\n","        chat = client.chat.completions.create(\n","            messages=[\n","                {\"role\": \"system\", \"content\": system_prompt},\n","                {\"role\": \"user\", \"content\": message}\n","            ],\n","            model=\"llama-3.3-70b-versatile\",\n","            temperature=0.2,\n","            response_format={\"type\": \"json_object\"}\n","        )\n","        llm_res = json.loads(chat.choices[0].message.content)\n","\n","        log_audit_trail(\n","            endpoint=\"/api/research-copilot\",\n","            prompt=message,\n","            response=llm_res,\n","            execution_time=time.time() - start_time\n","        )\n","\n","        return llm_res\n","\n","    except Exception as e:\n","        return {\n","            \"answer\": f\"Unable to process input: {str(e)}\",\n","            \"extracted_parameters\": {},\n","            \"takeaways\": []\n","        }\n","\n","# 3. Drug Discovery - Screen Compounds\n","@web_app.post(\"/api/screen-compounds\")\n","async def screen_compounds(req: CompoundScreeningRequest):\n","    start_time = time.time()\n","    groq_key = os.environ.get(\"GROQ_API_KEY\", \"\")\n","    client = Groq(api_key=groq_key)\n","\n","    prompt = f\"\"\"\n","    Target Protein: {req.target_protein}\n","    SMILES List: {json.dumps(req.smiles_list)}\n","\n","    Analyze each SMILES molecule for estimated binding affinity (kcal/mol), drug-likeness (0.0 to 1.0), and toxicity risk (Low/Medium/High).\n","    Return JSON format:\n","    {{\n","      \"target_protein\": \"{req.target_protein}\",\n","      \"ranked_candidates\": [\n","        {{\n","          \"smiles\": \"SMILES_STRING\",\n","          \"binding_affinity_kcal_mol\": -8.5,\n","          \"drug_likeness_score\": 0.88,\n","          \"toxicity_risk\": \"Low\",\n","          \"recommendation\": \"Advance to in-vitro assay\"\n","        }}\n","      ]\n","    }}\n","    \"\"\"\n","\n","    try:\n","        chat = client.chat.completions.create(\n","            messages=[{\"role\": \"user\", \"content\": prompt}],\n","            model=\"llama-3.3-70b-versatile\",\n","            temperature=0.2,\n","            response_format={\"type\": \"json_object\"}\n","        )\n","        llm_res = json.loads(chat.choices[0].message.content)\n","\n","        log_audit_trail(\n","            endpoint=\"/api/screen-compounds\",\n","            prompt=prompt,\n","            response=llm_res,\n","            execution_time=time.time() - start_time\n","        )\n","\n","        return llm_res\n","\n","    except Exception as e:\n","        return {\"error\": f\"Screening failed: {str(e)}\"}\n","\n","# 4. Generate Analytics Report\n","@web_app.post(\"/api/generate-analytics-report\")\n","async def generate_analytics_report(req: AnalyticsReportRequest):\n","    start_time = time.time()\n","    groq_key = os.environ.get(\"GROQ_API_KEY\", \"\")\n","    client = Groq(api_key=groq_key)\n","\n","    prompt = f\"\"\"\n","    Campaign ID: {req.campaign_id}\n","    Experimental Data Metrics: {json.dumps(req.metrics)}\n","\n","    Generate an executive summary and scientific analysis report based on these metrics.\n","    Return JSON format:\n","    {{\n","      \"campaign_id\": \"{req.campaign_id}\",\n","      \"executive_summary\": \"...\",\n","      \"key_findings\": [\"...\", \"...\"],\n","      \"recommended_next_experiments\": [\"...\", \"...\"]\n","    }}\n","    \"\"\"\n","\n","    try:\n","        chat = client.chat.completions.create(\n","            messages=[{\"role\": \"user\", \"content\": prompt}],\n","            model=\"llama-3.3-70b-versatile\",\n","            temperature=0.2,\n","            response_format={\"type\": \"json_object\"}\n","        )\n","        llm_res = json.loads(chat.choices[0].message.content)\n","\n","        log_audit_trail(\n","            endpoint=\"/api/generate-analytics-report\",\n","            prompt=prompt,\n","            response=llm_res,\n","            execution_time=time.time() - start_time\n","        )\n","\n","        return llm_res\n","\n","    except Exception as e:\n","        return {\"error\": f\"Report generation failed: {str(e)}\"}\n","\n","# 5. History Database Fetch\n","@web_app.get(\"/api/history/{sample_id}\")\n","async def get_history(sample_id: str):\n","    db = get_supabase()\n","    if not db:\n","        return {\"error\": \"Database not configured or credentials missing.\"}\n","    res = db.table(\"experiment_history\").select(\"*\").eq(\"sample_id\", sample_id).execute()\n","    return {\"history\": res.data}\n","\n","# Attach secrets to Modal\n","@app.function(secrets=[\n","    modal.Secret.from_name(\"groq-secret\")\n","])\n","@modal.asgi_app()\n","def fastapi_app():\n","    return web_app\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"77mLPFa05hvM","executionInfo":{"status":"ok","timestamp":1785345753331,"user_tz":-120,"elapsed":33,"user":{"displayName":"emmanuel nwachukwu","userId":"09003543583180748496"}},"outputId":"c103dbc9-13c6-437d-ef7d-495d35df8851"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Overwriting app.py\n"]}]},{"cell_type":"code","source":["!modal deploy app.py\n"],"metadata":{"id":"FXokxrOa5pT_","executionInfo":{"status":"ok","timestamp":1785345786767,"user_tz":-120,"elapsed":5349,"user":{"displayName":"emmanuel nwachukwu","userId":"09003543583180748496"}},"outputId":"85140078-380b-48b0-e68f-2db0c9bb851a","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\u001b[2K\u001b[34m⠸\u001b[0m Creating objects...\n","\u001b[2K\u001b[1A\u001b[2K\u001b[34m⠦\u001b[0m Creating o