","Best Conditions Found: {'temperature': 25.28, 'ph': 6.66, 'concentration_mm': 1.09}\n","=================================================================\n"]}],"source":["\"\"\"\n","Synapse AI Engine (v1.3.0 Live Groq Integration)\n","=================================================\n","Autonomous Laboratory Loop Orchestration System using Groq's Free API.\n","Ready to run out of the box in Google Colab (no pip installs needed).\n","\"\"\"\n","\n","import json\n","import os\n","import random\n","import time\n","import urllib.request\n","import urllib.error\n","from dataclasses import dataclass\n","from typing import Dict, Any, List\n","\n","\n","# =====================================================================\n","# 1. CONFIGURATION & KEYS\n","# =====================================================================\n","\n","@dataclass\n","class SynapseConfig:\n","    # Embedded Groq API key\n","    GROQ_API_KEY: str = \"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\"\n","    MODEL_NAME: str = \"llama-3.3-70b-versatile\"\n","    ECL_BASE_URL: str = \"https://constellation.emeraldcloudlab.com\"\n","    MAX_OPTIMIZATION_ITERATIONS: int = 3\n","\n","\n","# =====================================================================\n","# 2. GROQ-POWERED PROTOCOL PLANNER\n","# =====================================================================\n","\n","class SynapseGroqPlanner:\n","    \"\"\"Uses Groq API to dynamically generate SLL code from research goals.\"\"\"\n","\n","    def __init__(self, api_key: str, model: str):\n","        self.api_key = api_key\n","        self.model = model\n","        self.endpoint = \"https://api.groq.com/openai/v1/chat/completions\"\n","\n","    def compile_with_groq(self, objective: str, sample_id: str, parameters: Dict[str, float]) -> str:\n","        \"\"\"Queries Groq API to return executable Symbolic Lab Language (SLL).\"\"\"\n","\n","        if not self.api_key:\n","            print(\"  [Planner] (No Groq API key set — using local fallback compiler)\")\n","            return self._fallback_template(sample_id, parameters)\n","\n","        system_prompt = (\n","            \"You are Synapse AI, an expert lab automation system. \"\n","            \"Translate the human objective and quantitative parameters into executable \"\n","            \"Emerald Cloud Lab Symbolic Lab Language (SLL) / Mathematica script. \"\n","            \"Respond ONLY with valid code blocks.\"\n","        )\n","\n","        user_prompt = f\"\"\"\n","Research Objective: {objective}\n","Sample ID: {sample_id}\n","Parameters:\n","  - Temperature: {parameters['temperature']} °C\n","  - pH Level: {parameters['ph']}\n","  - Concentration: {parameters['concentration_mm']} mM\n","\n","Format output strictly as executable Symbolic Lab Language code.\n","\"\"\"\n","\n","        payload = {\n","            \"model\": self.model,\n","            \"messages\": [\n","                {\"role\": \"system\", \"content\": system_prompt},\n","                {\"role\": \"user\", \"content\": user_prompt}\n","            ],\n","            \"temperature\": 0.2\n","        }\n","\n","        headers = {\n","            \"Content-Type\": \"application/json\",\n","            \"Authorization\": f\"Bearer {self.api_key}\"\n","        }\n","\n","        try:\n","            req = urllib.request.Request(\n","                self.endpoint,\n","                data=json.dumps(payload).encode(\"utf-8\"),\n","                headers=headers,\n","                method=\"POST\"\n","            )\n","            with urllib.request.urlopen(req) as response:\n","                res = json.loads(response.read().decode(\"utf-8\"))\n","                generated_sll = res[\"choices\"][0][\"message\"][\"content\"]\n","                return generated_sll.strip()\n","\n","        except urllib.error.HTTPError as e:\n","            error_body = e.read().decode(\"utf-8\")\n","            print(f\"  [Groq API Error] Status {e.code}: {error_body[:100]}... Using fallback.\")\n","            return self._fallback_template(sample_id, parameters)\n","        except Exception as e:\n","            print(f\"  [Groq Connection Error]: {e}. Using fallback.\")\n","            return self._fallback_template(sample_id, parameters)\n","\n","    def _fallback_template(self, sample_id: str, parameters: Dict[str, float]) -> str:\n","        \"\"\"Fallback deterministic compiler.\"\"\"\n","        return f\"\"\"\n","(* Synapse AI SLL Standard Compiler *)\n","BeginExperiment[\"EnzymeKineticsScreen\"];\n","sampleObj = Object[\"{sample_id}\"];\n","preparedSample = ExperimentPrepare[\n","    Sample -> sampleObj,\n","    AdjustpH -> {parameters['ph']:.2f},\n","    SetConcentration -> Quantity[{parameters['concentration_mm']:.2f}, \"Millimolar\"],\n","    TargetTemperature -> Quantity[{parameters['temperature']:.1f}, \"DegreesCelsius\"]\n","];\n","EndExperiment[preparedSample];\n","\"\"\".strip()\n","\n","\n","# =====================================================================\n","# 3. OPTIMIZER & CLOUD LAB CLIENT\n","# =====================================================================\n","\n","class ActiveLearningEngine:\n","    def __init__(self):\n","        self.history: List[Dict[str, Any]] = []\n","\n","    def update(self, params: Dict[str, float], metric: float):\n","        self.history.append({\"params\": params, \"metric\": metric})\n","\n","    def suggest_next_parameters(self) -> Dict[str, float]:\n","        if not self.history:\n","            return {\"temperature\": 25.0, \"ph\": 6.5, \"concentration_mm\": 1.0}\n","\n","        best_run = max(self.history, key=lambda x: x[\"metric\"])\n","        best_p = best_run[\"params\"]\n","\n","        return {\n","            \"temperature\": round(max(20.0, min(80.0, best_p[\"temperature\"] + random.uniform(-2.0, 2.0))), 2),\n","            \"ph\": round(max(4.0, min(10.0, best_p[\"ph\"] + random.uniform(-0.3, 0.3))), 2),\n","            \"concentration_mm\": round(max(0.1, min(10.0, best_p[\"concentration_mm\"] + random.uniform(-0.1, 0.1))), 2)\n","        }\n","\n","\n","class ECLConstellationClient:\n","    def submit_job_and_read_data(self, sll_script: str, params: Dict[str, float]) -> Dict[str, Any]:\n","        time.sleep(0.3)\n","        job_hash = str(abs(hash(sll_script)))[:6]\n","        job_id = f\"ECL-JOB-{job_hash}\"\n","\n","        # Ground-truth physics calculation with simulated noise\n","        t_diff = params[\"temperature\"] - 37.0\n","        ph_diff = params[\"ph\"] - 7.4\n","        c_diff = params[\"concentration_mm\"] - 2.0\n","\n","        signal = 1.0 - (0.001 * (t_diff**2) + 0.08 * (ph_diff**2) + 0.05 * (c_diff**2))\n","        absorbance = round(max(0.01, min(1.0, signal + random.gauss(0.0, 0.01))), 4)\n","\n","        return {\"job_id\": job_id, \"absorbance_340nm\": absorbance}\n","\n","\n","# =====================================================================\n","# 4. MAIN SYSTEM ORCHESTRATOR\n","# =====================================================================\n","\n","def run_synapse_groq():\n","    config = SynapseConfig()\n","\n","    planner = SynapseGroqPlanner(config.GROQ_API_KEY, config.MODEL_NAME)\n","    optimizer = ActiveLearningEngine()\n","    ecl = ECLConstellationClient()\n","\n","    objective = \"Optimize enzyme activity for Target-Protein-X by tuning temp, pH, and substrate conc.\"\n","    sample_id = \"SMPL-ENZ-991\"\n","\n","    print(\"=================================================================\")\n","    print(\"      SYNAPSE AI - GROQ-POWERED AUTONOMOUS LAB ENGINE            \")\n","    print(\"=================================================================\")\n","    print(f\"Goal: {objective}\\n\")\n","\n","    for i in range(1, config.MAX_OPTIMIZATION_ITERATIONS + 1):\n","        print(f\"--- [LOOP ITERATION {i}/{config.MAX_OPTIMIZATION_ITERATIONS}] ---\")\n","\n","        # 1. Propose experimental parameters\n","        params = optimizer.suggest_next_parameters()\n","        print(f\"1. [Optimizer] Params: Temp={params['temperature']}°C, pH={params['ph']}, Conc={params['concentration_mm']}mM\")\n","\n","        # 2. Compile via Groq API\n","        print(\"2. [Groq AI] Querying Llama 3 via Groq to compile protocol...\")\n","        sll_script = planner.compile_with_groq(objective, sample_id, params)\n","        first_line = sll_script.splitlines()[0] if sll_script else \"No output\"\n","        print(f\"   [Groq SLL Output Preview]: {first_line[:60]}...\")\n","\n","        # 3. Simulate execution\n","        res = ecl.submit_job_and_read_data(sll_script, params)\n","        print(f\"3. [ECL Execution] Job {res['job_id']} Complete. Absorbance: {res['absorbance_340nm']}\\n\")\n","\n","        # 4. Feed results back to optimizer\n","        optimizer.update(params, res[\"absorbance_340nm\"])\n","\n","    best = max(optimizer.history, key=lambda x: x[\"metric\"])\n","    print(\"=================================================================\")\n","    print(f\"Optimization Complete! Peak Absorbance: {best['metric']}\")\n","    print(f\"Best Conditions Found: {best['params']}\")\n","    print(\"=================================================================\")\n","\n","if __name__ == \"__main__\":\n","    run_synapse_groq()\n"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"QarwPxlTqdpU"},"outputs":[],"source":["!pip install -q gradio\n"]},{"cell_type":"code","source":[],"metadata":{"id":"c-_W3pRov6RK"},"execution_count":null,"outputs":[]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true,"base_uri":"https://localhost:8080/","height":649},"id":"mCuLOy-iq7ph","outputId":"1c8079ba-e540-49c1-e6be-86e6471736a7"},"outputs":[{"name":"stderr","output_type":"stream","text":["/tmp/ipykernel_575/1253072458.py:160: UserWarning: The parameters have been moved from the Blocks constructor to the launch() method in Gradio 6.0: theme. Please pass these parameters to launch() instead.\n","  with gr.Blocks(theme=gr.themes.Soft(), title=\"Synapse AI Console\") as app:\n"]},{"name":"stdout","output_type":"stream","text":["Colab notebook detected. This cell will run indefinitely so that you can see errors and logs. To turn off, set debug=False in launch().\n","* Running on public URL: https://fedf6eb22a01b5a359.gradio.live\n","\n","This share link is temporary and will last for up to 1 week (best effort). For free permanent hosting and GPU upgrades, run `gradio deploy` from the terminal in the working directory to deploy to Hugging Face Spaces (https://huggingface.co/spaces)\n"]},{"data":{"text/html":["<div><iframe src=\"https://fedf6eb22a01b5a359.gradio.live\" width=\"100%\" height=\"500\" allow=\"autoplay; camera; microphone; clipboard-read; clipboard-write;\" frameborder=\"0\" allowfullscreen></iframe></div>"],"text/plain":["<IPython.core.display.HTML object>"]},"metadata":{},"output_type":"display_data"}],"source":["\"\"\"\n","Synapse AI Engine (v2.0.0 Interactive Gradio Web UI)\n","===================================================\n","Run an interactive scientific laboratory loop with live parameter tuning,\n","LLM protocol compilation via Groq, and visual analytics.\n","\"\"\"\n","\n","import json\n","import os\n","import random\n","import time\n","import urllib.request\n","import urllib.error\n","from dataclasses import dataclass\n","from typing import Dict, Any, List, Tuple\n","import gradio as gr\n","\n","\n","# =====================================================================\n","# 1. CORE ENGINE LOGIC\n","# =====================================================================\n","\n","class ActiveLearningEngine:\n","    def __init__(self):\n","        self.history: List[Dict[str, Any]] = []\n","\n","    def suggest_next_parameters(self, init_temp: float, init_ph: float, init_conc: float) -> Dict[str, float]:\n","        if not self.history:\n","            return {\"temperature\": init_temp, \"ph\": init_ph, \"concentration_mm\": init_conc}\n","\n","        best_run = max(self.history, key=lambda x: x[\"metric\"])\n","        best_p = best_run[\"params\"]\n","\n","        return {\n","            \"temperature\": round(max(20.0, min(80.0, best_p[\"temperature\"] + random.uniform(-2.0, 2.0))), 2),\n","            \"ph\": round(max(4.0, min(10.0, best_p[\"ph\"] + random.uniform(-0.3, 0.3))), 2),\n","            \"concentration_mm\": round(max(0.1, min(10.0, best_p[\"concentration_mm\"] + random.uniform(-0.1, 0.1))), 2)\n","        }\n","\n","    def update(self, params: Dict[str, float], metric: float):\n","        self.history.append({\"params\": params, \"metric\": metric})\n","\n","\n","class SynapseGroqPlanner:\n","    def __init__(self, api_key: str, model: str = \"llama-3.3-70b-versatile\"):\n","        self.api_key = api_key\n","        self.model = model\n","        self.endpoint = \"https://api.groq.com/openai/v1/chat/completions\"\n","\n","    def compile_sll(self, objective: str, sample_id: str, parameters: Dict[str, float]) -> str:\n","        if not self.api_key or self.api_key.strip() == \"\":\n","            return self._fallback_template(sample_id, parameters)\n","\n","        system_prompt = (\n","            \"You are Synapse AI, an expert lab automation system. \"\n","            \"Translate the human objective and parameters into executable \"\n","            \"Emerald Cloud Lab Symbolic Lab Language (SLL) code. Return ONLY valid SLL code.\"\n","        )\n","\n","        user_prompt = f\"Goal: {objective}\\nSample ID: {sample_id}\\nParameters: {parameters}\"\n","\n","        payload = {\n","            \"model\": self.model,\n","            \"messages\": [\n","                {\"role\": \"system\", \"content\": system_prompt},\n","                {\"role\": \"user\", \"content\": user_prompt}\n","            ],\n","            \"temperature\": 0.2\n","        }\n","\n","        headers = {\n","            \"Content-Type\": \"application/json\",\n","            \"Authorization\": f\"Bearer {self.api_key}\"\n","        }\n","\n","        try:\n","            req = urllib.request.Request(\n","                self.endpoint,\n","                data=json.dumps(payload).encode(\"utf-8\"),\n","                headers=headers,\n","                method=\"POST\"\n","            )\n","            with urllib.request.urlopen(req) as response:\n","                res = json.loads(response.read().decode(\"utf-8\"))\n","                return res[\"choices\"][0][\"message\"][\"content\"].strip()\n","        except Exception:\n","            return self._fallback_template(sample_id, parameters)\n","\n","    def _fallback_template(self, sample_id: str, parameters: Dict[str, float]) -> str:\n","        return f\"\"\"(* Synapse AI Fallback Protocol Compiler *)\n","BeginExperiment[\"EnzymeKineticsScreen\"];\n","sampleObj = Object[\"{sample_id}\"];\n","preparedSample = ExperimentPrepare[\n","    Sample -> sampleObj,\n","    AdjustpH -> {parameters['ph']:.2f},\n","    SetConcentration -> Quantity[{parameters['concentration_mm']:.2f}, \"Millimolar\"],\n","    TargetTemperature -> Quantity[{parameters['temperature']:.1f}, \"DegreesCelsius\"]\n","];\n","EndExperiment[preparedSample];\"\"\"\n","\n","\n","class ECLClient:\n","    def execute(self, sll_script: str, params: Dict[str, float]) -> Tuple[str, float]:\n","        job_hash = str(abs(hash(sll_script)))[:6]\n","        job_id = f\"ECL-JOB-{job_hash}\"\n","\n","        t_diff = params[\"temperature\"] - 37.0\n","        ph_diff = params[\"ph\"] - 7.4\n","        c_diff = params[\"concentration_mm\"] - 2.0\n","\n","        signal = 1.0 - (0.001 * (t_diff**2) + 0.08 * (ph_diff**2) + 0.05 * (c_diff**2))\n","        absorbance = round(max(0.01, min(1.0, signal + random.gauss(0.0, 0.01))), 4)\n","\n","        return job_id, absorbance\n","\n","\n","# =====================================================================\n","# 2. GRADIO EVENT HANDLER\n","# =====================================================================\n","\n","def run_experiment_loop(api_key, objective, sample_id, iterations, init_temp, init_ph, init_conc):\n","    optimizer = ActiveLearningEngine()\n","    planner = SynapseGroqPlanner(api_key)\n","    ecl = ECLClient()\n","\n","    execution_logs = \"\"\n","    last_protocol = \"\"\n","    chart_data = []\n","\n","    for i in range(1, int(iterations) + 1):\n","        params = optimizer.suggest_next_parameters(init_temp, init_ph, init_conc)\n","\n","        execution_logs += f\"=== Iteration {i}/{iterations} ===\\n\"\n","        execution_logs += f\"[Optimizer] Testing Temp: {params['temperature']}°C | pH: {params['ph']} | Conc: {params['concentration_mm']} mM\\n\"\n","\n","        sll_code = planner.compile_sll(objective, sample_id, params)\n","        last_protocol = sll_code\n","\n","        job_id, metric = ecl.execute(sll_code, params)\n","        optimizer.update(params, metric)\n","\n","        execution_logs += f\"[ECL Cloud] Executed Job: {job_id} -> Absorbance 340nm: {metric}\\n\\n\"\n","        chart_data.append([i, metric])\n","\n","    best = max(optimizer.history, key=lambda x: x[\"metric\"])\n","    summary = f\"\"\"### Optimization Finished Successfully!\n","- **Optimal Absorbance:** {best['metric']}\n","- **Optimal Temperature:** {best['params']['temperature']} °C\n","- **Optimal pH:** {best['params']['ph']}\n","- **Optimal Concentration:** {best['params']['concentration_mm']} mM\n","\"\"\"\n","\n","    return execution_logs, last_protocol, summary\n","\n","\n","# =====================================================================\n","# 3. GRADIO UI LAYOUT\n","# =====================================================================\n","\n","with gr.Blocks(theme=gr.themes.Soft(), title=\"Synapse AI Console\") as app:\n","    gr.Markdown(\"# 🧪 Synapse AI — Autonomous Laboratory Console\")\n","    gr.Markdown(\"Configure your research target, adjust parameters, and trigger AI-driven laboratory optimization.\")\n","\n","    w